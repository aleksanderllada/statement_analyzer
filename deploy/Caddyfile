# Snippet appended to ~/n8n-docker-caddy/caddy_config/Caddyfile on the host.
# Cloudflare proxies the public hostname (orange cloud, SSL mode Full), so
# Caddy uses its internal CA for the origin cert.

st.aarruda.com {
	tls internal

	encode gzip

	# Backend: strip /api prefix and forward to the FastAPI container.
	handle_path /api/* {
		reverse_proxy statement_analyzer:8001
	}

	# Static frontend (Vite build) mounted into the Caddy container.
	handle {
		root * /srv/st.aarruda.com
		try_files {path} /index.html
		file_server
	}
}
