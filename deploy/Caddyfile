# Snippet merged into ~/n8n-docker-caddy/caddy_config/Caddyfile on the host.
#
# Layers in front of the app:
#   - Cloudflare proxies the hostname (orange cloud, SSL mode Full).
#   - Cloudflare Access gates every request (email OTP policy).
#   - Cloudflare Authenticated Origin Pulls: CF presents a client cert from
#     its origin-pull CA. Caddy below requires it via client_auth, so direct
#     connections to the origin IP (bypassing CF) fail at the TLS handshake.
#
# cloudflare-origin-pull-ca.pem is the public CA cert that signs CF's
# origin-pull cert; it lives next to this file and is mounted into Caddy.

st.aarruda.com {
	tls internal {
		client_auth {
			mode require_and_verify
			trust_pool file /config/cloudflare-origin-pull-ca.pem
		}
	}

	encode gzip

	# Backend: strip /api prefix and forward to the FastAPI container.
	handle_path /api/* {
		reverse_proxy statement_analyzer:8001
	}

	# Static frontend (Vite build) mounted into the Caddy container.
	handle {
		root * /srv/st.aarruda.com
		try_files {path} /index.html
		file_server
	}
}
